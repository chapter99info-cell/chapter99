# Supabase (required for /admin auth + data)
# In Vercel, use VITE_ prefix so Vite exposes them to the browser:
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Claude API (optional — for "Run Claude API" button in admin)
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key
