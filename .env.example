# Supabase (required for /admin auth + data)
# Production uses Creator Network project jjbwiriphyxsnrnpoqnn
VITE_SUPABASE_URL=https://jjbwiriphyxsnrnpoqnn.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Apply agency admin schema (scripts/apply-agency-admin-schema.mjs)
# SUPABASE_DB_PASSWORD=from-dashboard-settings-database

# Smoke test Task Board (scripts/smoke-test-task-board.mjs)
# ADMIN_TEST_EMAIL=
# ADMIN_TEST_PASSWORD=

# Claude API (optional — for "Run Claude API" button in admin)
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key

# Gemini API (optional — for "Run Gemini API" button in admin)
VITE_GEMINI_API_KEY=your-gemini-api-key

# Admin PIN (Vercel server-side only — never prefix with VITE_)
ADMIN_PIN=your-4-digit-pin
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Supabase Edge Function path (legacy — app uses /api/verify-admin-pin on Vercel)
# Set in Supabase Dashboard → Edge Functions → Secrets if using Edge Function instead:
# ADMIN_PIN=your-4-digit-pin
